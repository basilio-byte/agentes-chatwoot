// Seahub Agentes — schema principal.
// Single-tenant: atende apenas a Seahub, não há tenantId por decisão de 2026-07-28.
// A URL do banco fica em prisma.config.ts (Prisma 7), lida de DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Acesso ao painel
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER // gerencia credenciais de integração
  ADMIN // gerencia agentes
  VIEWER // só leitura
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentVersions AgentVersion[]
  auditLogs     AuditLog[]
  agentesQuePossui  Agent[] @relation("DonoDoAgente")
  agentesQueAlterou Agent[] @relation("UltimaAlteracaoDoAgente")
  mcpTokens         McpToken[]
}

/// Token pessoal do servidor MCP (`/api/mcp`): conecta um assistente de I.A. ao
/// painel com o poder da conta dona dele, e nada além.
///
/// ⚠ Guarda o HASH, nunca o token. O do gatilho é cifrado porque é conferido
/// contra UM agente conhecido pela URL; este é procurado entre os tokens de
/// todo mundo, e a busca é pelo hash. O texto puro aparece uma vez só, na tela,
/// no momento em que é gerado.
///
/// O papel NÃO mora aqui: é lido da conta a cada requisição. Rebaixar alguém a
/// Leitura, ou desativar a conta, vale para o token na mesma hora.
model McpToken {
  id     String @id @default(cuid())
  userId String

  /// Onde ele está em uso ("Claude Code no notebook") — é o que quem for
  /// revogar precisa ler.
  nome      String
  tokenHash String @unique
  /// `seahub_mcp_…a1b2`, para reconhecer sem revelar.
  hint      String

  createdAt  DateTime  @default(now())
  /// Gravado no máximo uma vez por minuto: a cada chamada seria uma escrita
  /// por leitura.
  lastUsedAt DateTime?
  /// Revogar não apaga: a auditoria das alterações feitas aponta para este id.
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Agentes
// ---------------------------------------------------------------------------

model Agent {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  /// Identificador curto e estável usado pelos colegas para transferir
  /// ("vendas", "suporte"). O modelo não consegue usar cuid de forma confiável —
  /// e mudar o nome do agente não pode quebrar as transferências.
  key String @unique

  /// "Quando me transferir uma conversa." Entra no prompt de TODOS os outros
  /// agentes como roster; é por aqui que um colega sabe que este existe.
  /// Separado do systemPrompt de propósito: o prompt fala com o próprio agente,
  /// este texto fala com os outros.
  routingDescription String? @db.Text

  /// O agente de entrada recebe a primeira mensagem e distribui. Só um pode
  /// estar ligado — sem isso, quem responde primeiro seria arbitrário.
  isEntry Boolean @default(false)

  /// Em quais caixas de entrada do Chatwoot este agente atua.
  /// `all` = qualquer uma; `specific` = só as listadas em `inboxIds`.
  inboxMode String @default("all") // all | specific
  /// Ids das caixas no Chatwoot. Só vale com `inboxMode = specific`.
  inboxIds  Int[]  @default([])

  systemPrompt String @db.Text

  // Modelo e custo. Ver docs/00-stack-e-arquitetura.md §7.
  // `model` é o slug da OpenRouter (ex.: "openai/gpt-5.6-luna").
  model             String @default("openai/gpt-5.6-luna")
  effort            String @default("medium") // none | low | medium | high
  /// Teto de saída por chamada. Alto de propósito: um turno pode encadear
  /// transferências e vários usos de tool antes da resposta final, e o runner
  /// ainda corta pelo limite real do modelo (ModeloCatalogo.maxSaida).
  maxTokens         Int    @default(16384)
  /// Rodadas de tool por turno. Descobrir estrutura, consultar e então agir já
  /// gasta várias — 12 dá folga sem virar laço infinito.
  maxToolIterations Int    @default(12)

  active Boolean @default(false) // nasce desligado: só entra em produção de propósito

  /// Guardado sem apagar: some da lista principal e não atende, mas mantém
  /// prompt, modelo, integrações e histórico intactos.
  ///
  /// Estado separado de `active` de propósito. Desligado é pausa; arquivado é
  /// "tirei de circulação". Restaurar devolve o agente **desligado** — voltar a
  /// atender é uma segunda decisão, consciente.
  archivedAt DateTime?

  /// Quantos minutos o cliente pode ficar esperando antes de a conversa ser
  /// entregue a uma pessoa. Nulo = usa o padrão do sistema.
  ///
  /// Existe porque nem toda falha grita: modelo pendurado, worker morto no meio
  /// do turno ou job perdido deixam o cliente no vácuo sem erro nenhum.
  fallbackMinutos Int?
  /// Para quem escalar quando o tempo estoura. Nulo = devolve à fila humana
  /// sem escolher pessoa.
  fallbackAtendente String?

  /// Espera antes de responder, para agrupar mensagens picotadas do cliente
  /// ("oi" / "tudo bem?" / "queria saber sobre sala") numa resposta só.
  /// Canal mais conversacional pede mais; e-mail pede menos.
  debounceSeconds Int @default(6)

  // Repasse para humano
  handoffEnabled  Boolean @default(true)
  handoffTeamId   Int? // id do time no Chatwoot
  handoffOnErrors Int     @default(2) // nº de falhas de tool antes de transferir

  /// Quem responde pelo agente. Não é controle de acesso — é saber a quem
  /// perguntar quando o atendimento sair errado.
  ownerId String?
  /// Quem mexeu por último, para a tela mostrar sem ter de abrir a auditoria.
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User? @relation("DonoDoAgente", fields: [ownerId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("UltimaAlteracaoDoAgente", fields: [updatedById], references: [id], onDelete: SetNull)

  versions      AgentVersion[]
  integrations  AgentIntegration[]
  conversations Conversation[]
  runs          AgentRun[]
  chatwootBot   AgentChatwootBot?
  trigger       AgentTrigger?
  schedules     AgentSchedule[]
  prazos        PrazoDeConversa[]
  gatilhosDeConversa GatilhoDeConversa[]

  handoffsFeitos    AgentHandoff[] @relation("HandoffDe")
  handoffsRecebidos AgentHandoff[] @relation("HandoffPara")
  conversasEmTransicao Conversation[] @relation("HandoffDestino")

  @@index([isEntry])
  @@index([archivedAt])
}

/// Registro de cada passagem de bastão entre agentes.
///
/// Auditoria, não estado: o estado de quem atende agora fica em
/// `Conversation.agentId`. Serve para responder "por que este agente respondeu?"
/// e para achar par de agentes que vive se transferindo.
model AgentHandoff {
  id             String  @id @default(cuid())
  conversationId String
  /// Nulo quando quem passou foi um humano ou o próprio sistema.
  fromAgentId    String?
  toAgentId      String

  motivo String? @db.Text
  resumo String? @db.Text
  /// O que o cliente viu no momento da passagem.
  aviso  String? @db.Text

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromAgent    Agent?       @relation("HandoffDe", fields: [fromAgentId], references: [id], onDelete: SetNull)
  toAgent      Agent        @relation("HandoffPara", fields: [toAgentId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Um Agent Bot do Chatwoot por agente — decisão de 2026-07-28, para cada agente
/// ter nome e avatar próprios na interface do Chatwoot.
///
/// Consequência: cada bot tem o **seu** secret de webhook. Por isso o endpoint é
/// `/api/webhooks/chatwoot/<agentId>` — a URL identifica o bot antes da
/// verificação da assinatura, evitando ter de confiar no payload para escolher a
/// chave.
model AgentChatwootBot {
  id      String @id @default(cuid())
  agentId String @unique

  /// Id numérico do bot no Chatwoot. Serve para vincular inboxes e para ignorar
  /// as mensagens que o próprio bot enviou.
  botId   Int?
  botName String

  /// Conta do Chatwoot deste bot. Nulo = usa a conta da configuração global.
  /// Permite ter agentes em contas diferentes da mesma instância.
  accountId Int?

  /// JSON cifrado (AES-256-GCM): { token, webhookSecret }.
  /// Um blob só em vez de duas colunas cifradas — menos ruído no schema.
  ciphertext String @db.Text
  iv         String
  authTag    String
  /// Máscara do token, para conferência visual no painel.
  hint       String

  rotatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

/// Gatilho HTTP genérico por agente — aciona fora de uma conversa do Chatwoot,
/// por POST de qualquer sistema externo (ClickUp, n8n, curl). A URL inteira é
/// `/api/webhooks/gatilho/<agentId>/<token>`.
///
/// Diferente de toda outra credencial do projeto: aqui o segredo nasce do
/// NOSSO lado — é a única forma de o operador colá-lo na URL configurada no
/// sistema externo. Por isso é devolvido em texto puro uma única vez, na
/// criação/rotação; depois, só `hint`. Cifrado em repouso como tudo mais.
model AgentTrigger {
  id      String @id @default(cuid())
  agentId String @unique

  /// Nasce DESLIGADO — mesma doutrina de Agent.active/Integration.enabled
  /// ("só entra em produção de propósito"). Gerar o token não liga sozinho; o
  /// operador ainda precisa configurar o prompt e ligar conscientemente.
  enabled Boolean @default(false)

  ciphertext String @db.Text
  iv         String
  authTag    String
  hint       String

  rotatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Preenchido quando o teto de execuções estourou e o sistema desligou o
  /// gatilho sozinho. Fica visível no painel — silêncio precisa deixar
  /// rastro — e só some quando alguém religar conscientemente.
  pausadoAutomaticamenteEm     DateTime?
  pausadoAutomaticamenteMotivo String?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

/// Um agendamento: o agente roda sozinho na hora marcada, sem gatilho externo.
///
/// Vários por agente de propósito — diferente de `AgentTrigger`, que é um só.
/// "Resumo às 8h" e "cobranças às 18h" são dois agendamentos do mesmo agente,
/// com instruções diferentes, e cada um liga e desliga por conta própria.
///
/// ⚠ **O Postgres é a fonte da verdade; o Redis só executa.** O relógio de
/// verdade é o Job Scheduler do BullMQ, que vive no Redis — mas Redis limpo
/// faria os agendamentos sumirem em silêncio. Por isso o worker reconcilia
/// estas linhas contra o Redis toda vez que sobe.
model AgentSchedule {
  id      String @id @default(cuid())
  agentId String

  /// Como aparece na tela e no rastro de execução. "Resumo diário".
  nome String

  /// Expressão de 5 campos, **sempre** interpretada em `America/Sao_Paulo`.
  /// O container roda em UTC: sem fuso explícito, "9h" viraria 6h da manhã.
  cron String

  /// O que o agente deve fazer nesta execução. Vira a `mensagem` do turno —
  /// aqui não há payload de sistema externo nem cliente perguntando nada.
  instrucao String @db.Text

  /// Nasce desligado, como `Agent.active` e `AgentTrigger.enabled`.
  enabled Boolean @default(false)

  /// Quanto tempo depois da hora marcada ainda vale executar.
  ///
  /// O worker fora do ar na hora marcada (deploy, queda) faz o BullMQ entregar
  /// a ocorrência atrasada quando volta. Rodar o "resumo das 8h" às 15h como se
  /// nada fosse é pior que não rodar: o agente age sobre um contexto que já
  /// passou. Passou da tolerância, pula e registra o motivo.
  toleranciaMinutos Int @default(60)

  ultimaExecucaoEm DateTime?
  /// `executado` · `falhou` · `pulado` · `interrompido`.
  ultimoResultado  String?
  ultimoDetalhe    String?

  /// Zera a cada sucesso. Estourou o teto, o agendamento se desliga sozinho —
  /// agendamento quebrado não pode queimar crédito para sempre.
  falhasConsecutivas Int @default(0)

  pausadoAutomaticamenteEm     DateTime?
  pausadoAutomaticamenteMotivo String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([enabled])
}

/// O que acontece numa conversa do Chatwoot e aciona um agente.
enum EventoDeConversa {
  /// A conversa foi resolvida.
  RESOLVIDA
  /// Alguém da equipe marcou um checkbox (atributo personalizado) da conversa.
  /// Quais checkboxes: `GatilhoDeConversa.atributos`.
  ATRIBUTO_MARCADO

  /// A conversa está aberta, com alguém da equipe atendendo, e ninguém falou
  /// com o cliente há mais de `GatilhoDeConversa.horasParadas`.
  ///
  /// ⚠ Os outros dois eventos são REATIVOS: o Chatwoot avisa e nós agimos.
  /// Este é ATIVO — quem aciona é o relógio (`cron`), e é preciso varrer as
  /// conversas para descobrir quais se encaixam. É a diferença que obriga a
  /// fila a ter dois passos: uma varredura por rodada e uma execução por
  /// conversa.
  SEM_RESPOSTA
}

/// Quando algo acontece numa conversa do Chatwoot, este agente roda sobre ela
/// em segundo plano, com a transcrição do atendimento.
///
/// Nasceu para substituir o "Olho de tudo" do n8n (15/09/2026): toda conversa
/// resolvida é avaliada e a nota vai para o CRM. Feito para receber outros
/// eventos — checkbox marcado, para o NPS e o CRM por checkbox — sem refazer a
/// tabela. Vários por agente, um por evento.
///
/// Diferente de `AgentTrigger`: não há sistema externo nem token. Quem avisa é o
/// webhook de conta do Chatwoot, que já existe e já é assinado.
///
/// ⚠ As caixas NÃO moram aqui: vale o escopo do agente (`Agent.inboxMode`), o
/// mesmo que a aba Canal edita. Duas listas de caixas para o mesmo agente
/// divergiriam na primeira edição.
model GatilhoDeConversa {
  id      String           @id @default(cuid())
  agentId String
  evento  EventoDeConversa

  /// Nasce desligado, como todo gatilho.
  enabled Boolean @default(false)

  /// Só roda se uma pessoa da equipe respondeu ao cliente naquele atendimento.
  /// Conferido ANTES de chamar o modelo: conversa que só teve robô ou nota
  /// interna não custa nada.
  exigeAtendimentoHumano Boolean @default(true)

  /// Nomes de contas do Chatwoot cujas mensagens não contam como pessoa. O n8n
  /// escreve com o token do Basílio (decisão do usuário, 15/09/2026).
  contasDeAutomacao String[] @default([])

  /// Só em `ATRIBUTO_MARCADO`: as chaves dos checkboxes da conversa que acionam
  /// o agente, como estão no Chatwoot (`passar_para_crm`). Lista, e não uma linha
  /// por checkbox, porque o mesmo agente pode escutar mais de um — o NPS tem
  /// dois — e a unique continua sendo agente + evento.
  atributos String[] @default([])

  /// Só em `SEM_RESPOSTA`: quando varrer, em 5 campos, sempre em
  /// `America/Sao_Paulo` — o container roda em UTC, e "7h" sem fuso dispara às
  /// 4h da manhã. Mesmo relógio de `AgentSchedule`.
  cron String?

  /// Só em `SEM_RESPOSTA`: a conversa só entra se ninguém falou com o cliente
  /// há mais horas que isto.
  ///
  /// ⚠ Contado pela última mensagem PÚBLICA, nunca pela última atividade da
  /// conversa: a nota interna que este mesmo agente escreve é a última
  /// mensagem não-atividade, e pelo outro critério comentar uma conversa a
  /// faria parecer ativa — o filtro passaria a esconder justamente o que
  /// acabou de ser marcado como parado.
  horasParadas Int @default(24)

  /// Só em `SEM_RESPOSTA`: teto de execuções pagas por rodada.
  ///
  /// A varredura não custa modelo; cada conversa analisada custa. Sem teto, um
  /// dia atípico — mutirão de conversas antigas reabertas — vira fatura que
  /// ninguém aprovou. Estourou, as excedentes ficam para a rodada seguinte e
  /// o resumo diz quantas foram.
  tetoPorRodada Int @default(60)

  ultimaExecucaoEm DateTime?
  /// `executado` · `ignorado` · `falhou` · `interrompido`.
  ///
  /// Em `SEM_RESPOSTA` quem escreve aqui é a VARREDURA, com o resumo da rodada
  /// inteira ("107 conversas, 82 paradas, 12 analisadas"): é a pergunta que
  /// quem abre a tela faz, e ela não seria respondida pelo desfecho da última
  /// conversa a terminar.
  ultimoResultado  String?
  ultimoDetalhe    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, evento])
  @@index([evento, enabled])
}

/// Histórico imutável de prompt. Permite rollback quando um ajuste piora o atendimento.
model AgentVersion {
  id      String @id @default(cuid())
  agentId String
  version Int

  systemPrompt String  @db.Text
  model        String
  effort       String
  note         String?

  createdById String?
  createdAt   DateTime @default(now())

  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([agentId, version])
  @@index([agentId])
  @@index([agentId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Integrações
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  CHATWOOT
  CLICKUP
  CONEXA
  ZAPSIGN
  /// Leitura de mídia (áudio, imagem, documento). Não expõe tool nenhuma: é um
  /// passo de preparo do contexto, antes de o agente pensar. Está aqui, e não
  /// numa tabela própria, para reusar credencial cifrada, toggle global e
  /// toggle por agente — capacidade duplicada é a que diverge.
  OPENAI
  /// Conferência de documento (CPF, CNH, CNPJ). Sem credencial: usa algoritmo
  /// público e a consulta gratuita de CNPJ da base aberta da Receita. Está no
  /// registry pelo toggle de dois níveis e pela allowlist, não pela conta.
  DOCUMENTOS
  /// Google Workspace — Sheets, Docs e Drive por uma conta de serviço. Um
  /// provider só, e não três, porque a credencial é UMA (IntegrationCredential
  /// é 1:1 com Integration) e porque gerar documento a partir de modelo
  /// atravessa Drive e Docs na mesma tool. A separação que o operador vê vem
  /// de `categoria` e da allowlist, que é onde ela custa zero.
  GOOGLE
  /// Prazos da conversa: o agente registra "se ninguém responder em N minutos,
  /// faça X", e o vigia do worker executa conferindo o Chatwoot ao vivo. Sem
  /// credencial. Provider próprio, e não tool a mais do Chatwoot, para ser
  /// OPT-IN por agente: tool nova no Chatwoot apareceria para todo agente com
  /// as ferramentas dele liberadas, como aconteceu com a chamada interna.
  PRAZOS
  /// Pesquisa de satisfação (NPS) como função do sistema, sem modelo: o
  /// checkbox manda a pesquisa, a nota é capturada antes dos agentes, vai para o
  /// CRM e a conversa é resolvida. FORA do registry de propósito: não tem tool
  /// nem liga por agente. A linha guarda só o liga/desliga e a configuração.
  NPS
}

enum IntegrationStatus {
  NOT_CONFIGURED
  OK
  ERROR
}

/// Uma conexão configurada. `enabled` é o toggle GLOBAL: desligou aqui,
/// nenhum agente enxerga as tools desta integração.
model Integration {
  id       String              @id @default(cuid())
  provider IntegrationProvider @unique
  label    String

  /// Config não-sensível (baseUrl, accountId, workspaceId...). Validada por Zod no registry.
  config Json @default("{}")

  enabled Boolean @default(false)

  status        IntegrationStatus @default(NOT_CONFIGURED)
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credential IntegrationCredential?
  agents     AgentIntegration[]
}

/// Segredos cifrados (AES-256-GCM), separados da config visível.
/// A API nunca devolve `ciphertext` — só `hint`.
model IntegrationCredential {
  id            String @id @default(cuid())
  integrationId String @unique

  ciphertext String @db.Text
  iv         String
  authTag    String
  hint       String // ex.: "••••4f2a", para conferência visual no painel

  rotatedAt DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

/// Toggle POR AGENTE + allowlist de tools. O array de tools enviado ao modelo é a
/// interseção deste nível com Integration.enabled.
model AgentIntegration {
  id            String @id @default(cuid())
  agentId       String
  integrationId String

  enabled Boolean @default(false)

  /// Vazio = todas as tools da integração. Preenchido = só estas.
  allowedTools String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([agentId, integrationId])
  @@index([agentId])
  @@index([agentId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Conversas e execuções
// ---------------------------------------------------------------------------

enum ConversationStatus {
  BOT // agente respondendo
  HUMAN // transferida, bot calado
  CLOSED
}

model Conversation {
  id                     String @id @default(cuid())
  chatwootConversationId Int    @unique
  chatwootInboxId        Int

  agentId String?
  status  ConversationStatus @default(BOT)

  contactName       String?
  contactIdentifier String?

  handoffReason String?
  handoffAt     DateTime?

  /// Bastão da última passagem entre agentes. Lido pelo agente que assumiu e
  /// injetado como mensagem `system` antes da fala do cliente — nunca no
  /// systemPrompt, que precisa ficar estável para o cache do provedor.
  ///
  /// Zerado junto com `historicoDesde` quando a conversa é resolvida: reabriu,
  /// volta para o agente de entrada sem herdar o especialista anterior.
  handoffParaAgentId String?
  handoffResumo      String? @db.Text
  handoffMotivo      String? @db.Text
  handoffDeNome      String?

  /// Marco de corte do histórico. Mensagens anteriores a esta data não vão para
  /// o modelo.
  ///
  /// É gravado toda vez que a conversa é vista como resolvida: se ela reabrir, o
  /// atendimento começa do zero, porque o mesmo cliente costuma voltar por outro
  /// assunto e o contexto antigo atrapalharia mais do que ajudaria.
  historicoDesde DateTime?
  resolvidaEm    DateTime?

  /// Desde quando o cliente espera resposta. Gravado quando a mensagem dele
  /// entra na fila e zerado quando o agente responde — é o relógio do vigia.
  ///
  /// Separado de , que é atualizado pelos dois lados e por isso
  /// não distingue "cliente esperando" de "conversa ativa".
  aguardandoDesde DateTime?

  /// O atendimento VOLTOU para o agente: a pessoa da equipe não respondeu a
  /// tempo (prazo da equipe com `voltar_para_o_agente`). Com o bastão endereçado
  /// a ele, a instrução de retomada entra no lugar da de passagem, em todo turno
  /// do atendimento. Zerado ao resolver e ao transferir para outro agente.
  retomadaEm       DateTime?
  /// O agente ainda não falou depois da volta: o worker roda o turno mesmo sem
  /// mensagem nova do cliente. Zerado na primeira resposta enviada, ao
  /// transferir, ao entregar a uma pessoa e ao resolver.
  retomadaPendente Boolean   @default(false)

  /// Agente dono do bot pelo qual a conversa entrou. Quem precisa falar com o
  /// Chatwoot fora de um turno (o vigia) não teria outro jeito de achar a
  /// credencial certa.
  portaAgentId String?

  /// Por que o último processamento não chegou a responder.
  ///
  /// Falha antes da chamada ao modelo não cria `AgentRun` — sem isto, o painel
  /// mostrava "ainda sem resposta" para sempre e a causa só existia no log do
  /// container.
  ultimaFalha   String?
  ultimaFalhaEm DateTime?

  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agent          Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  handoffPara    Agent?         @relation("HandoffDestino", fields: [handoffParaAgentId], references: [id], onDelete: SetNull)
  runs           AgentRun[]
  handoffs       AgentHandoff[]

  @@index([agentId])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([status])
}

enum RunSource {
  PLAYGROUND
  CHATWOOT
  TRIGGER
  /// Disparado pelo relógio, sem ninguém do outro lado.
  SCHEDULE

  /// A mesa do agente: página própria, aberta por alguém da equipe, onde se
  /// envia um arquivo e o agente executa UMA vez sobre ele.
  ///
  /// Origem própria, e não `PLAYGROUND`, por dois motivos que não se resolvem
  /// com um filtro na tela. O primeiro é dinheiro: no playground alguém afina
  /// prompt, na mesa alguém trabalha — misturar os dois em /consumo faz o
  /// custo de conferência parecer teste. O segundo é o prompt: `tipoDeTurno`
  /// manda PLAYGROUND para a cauda de conversa, que afirma "do outro lado tem
  /// uma pessoa de verdade, no WhatsApp, lendo no celular" e limita a três
  /// parágrafos sem markdown — quatro afirmações falsas justamente no turno
  /// que existe para produzir um laudo.
  ///
  /// ⚠ E também não serve a cauda `sem-conversa`: ela declara que a mensagem
  /// de abertura "vem da equipe da Seahub, não de um cliente, e é para ser
  /// cumprida mesmo que o assunto não apareça nas instruções acima". Na mesa
  /// o corpo dessa mensagem é o texto extraído do documento de um terceiro.
  MESA

  /// Chamada interna: outro agente acionou este em segundo plano, no meio do
  /// próprio turno, e o resultado volta para quem acionou — sem passar a
  /// conversa e sem o cliente ver nada (`agents/chamada-interna.ts`).
  ///
  /// Origem própria por dois motivos. O prompt: nenhuma cauda existente é
  /// verdade aqui — a de conversa manda confirmar com o cliente antes de
  /// registrar, e a de gatilho manda escrever para a equipe. E o dinheiro: em
  /// /consumo o serviço interno aparece separado do atendimento que o acionou.
  INTERNO

  /// Uma conversa do Chatwoot foi resolvida e um `GatilhoDeConversa` acionou
  /// este agente em segundo plano, com a transcrição do atendimento
  /// (`server/conversa-encerrada/`).
  ///
  /// Origem própria porque nenhuma cauda existente é verdade aqui: não há
  /// cliente lendo (a de conversa mentiria), a tarefa está nas instruções do
  /// agente e não na mensagem (a de gatilho carimbaria a transcrição inteira
  /// como "vem da equipe e é para cumprir"), e o corpo da mensagem é conversa de
  /// terceiro — dado para examinar, nunca ordem.
  CONVERSA_ENCERRADA

  /// Alguém da equipe marcou um checkbox numa conversa do Chatwoot e um
  /// `GatilhoDeConversa` de `ATRIBUTO_MARCADO` acionou este agente sobre o
  /// atendimento atual (`server/conversa-marcada/`).
  ///
  /// Origem própria, e não `CONVERSA_ENCERRADA`, porque a cauda de lá afirma
  /// que a conversa foi resolvida — e aqui ela costuma estar aberta, com a
  /// pessoa que marcou atendendo. Regra falsa é pior que regra ausente.
  CONVERSA_MARCADA

  /// O relógio varreu as conversas abertas e esta está parada há mais de
  /// `GatilhoDeConversa.horasParadas`: o agente lê o atendimento e deixa uma
  /// nota interna para quem está com ela (`server/conversa-parada/`).
  ///
  /// Substitui o fluxo "Comercial - Assistente Vendedor" do n8n, despublicado
  /// pelo usuário em 17/09/2026.
  ///
  /// ⚠ É a única origem em que o agente age numa conversa de OUTRA pessoa, e
  /// de propósito: quem atende é gente, continua atendendo, e o agente só
  /// escreve para ela. A garantia de que nada vaza para o cliente não é o
  /// prompt — é o turno em segundo plano, sem as ferramentas de canal, e o
  /// texto final que não é enviado a ninguém.
  CONVERSA_PARADA
}

enum RunStatus {
  RUNNING
  SUCCESS
  ERROR
  /// Interrompida de propósito por alguém no painel.
  ///
  /// Separado de `ERROR` porque não é falha: a apuração de consumo conta erros
  /// para dizer "quanto se gastou sem resultado", e uma parada deliberada
  /// entrando nessa conta faria o operador caçar um defeito que ele mesmo
  /// causou. O custo até o ponto da parada continua sendo cobrado e contado.
  CANCELED
}

/// Uma execução completa do agente (do input até a resposta final).
/// É isto que permite responder "por que o bot respondeu isso?".
model AgentRun {
  id             String  @id @default(cuid())
  agentId        String
  conversationId String?

  source RunSource
  status RunStatus @default(RUNNING)

  /// Slug da OpenRouter usado NESTA execução, congelado no momento em que ela
  /// rodou. Sem isto a apuração de consumo por modelo teria de ler
  /// `Agent.model`, que é o modelo de **agora** — trocar de modelo reescreveria
  /// o passado inteiro da fatura.
  ///
  /// A migration preencheu o histórico a partir de `AgentVersion` (a versão
  /// vigente na data da execução). Fica **nulo** só onde não havia evidência
  /// nenhuma: agente sem histórico de versão, anterior ao versionamento. Aí a
  /// tela de Consumo mostra "modelo não registrado" em vez de chutar o modelo
  /// atual do agente — o custo total continua certo, e a quebra por modelo diz
  /// a verdade sobre o que não dá para saber.
  model String?

  input  String  @db.Text
  output String? @db.Text

  /// Histórico completo enviado/recebido, para replay e depuração.
  messages Json @default("[]")

  inputTokens         Int @default(0)
  outputTokens        Int @default(0)
  cacheReadTokens     Int @default(0)
  cacheCreationTokens Int @default(0)

  costUsd    Decimal? @db.Decimal(12, 6)
  latencyMs  Int?
  iterations Int      @default(0)

  error String? @db.Text

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  toolCalls    ToolCall[]

  @@index([agentId, createdAt])
  @@index([conversationId])
  /// A apuração de consumo varre por PERÍODO, sem agente: o índice composto
  /// acima não serve, porque `agentId` é a primeira coluna dele.
  @@index([createdAt])
}

model ToolCall {
  id    String @id @default(cuid())
  runId String

  toolName   String
  provider   IntegrationProvider?
  input      Json
  output     Json?
  isError    Boolean              @default(false)
  durationMs Int?

  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ---------------------------------------------------------------------------
// Operação
// ---------------------------------------------------------------------------

/// Deduplicação de webhook: o Chatwoot reenvia em caso de falha.
model WebhookEvent {
  id       String @id @default(cuid())
  provider String
  /// X-Chatwoot-Delivery. É a chave de idempotência: o Chatwoot reenvia em falha.
  externalId String
  eventType  String
  /// Qual agente recebeu — vem da URL do webhook, uma por bot.
  agentId    String?
  payload    Json

  /// O que o sistema fez com a entrega: `agendado`, `ignorado` ou `rejeitado`.
  ///
  /// Existe para a tela do agente responder "chegou alguma coisa?" sem obrigar
  /// ninguém a ler log de container. Sem isto, entrega recusada por assinatura
  /// não deixava rastro nenhum — voltava 401 antes de qualquer escrita — e o
  /// operador só via silêncio.
  resultado String?
  /// Por que foi ignorada ou recusada, em texto para humano.
  detalhe   String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([processedAt])
  @@index([agentId])
  @@index([agentId, createdAt(sort: Desc)])
}

/// O que o anexo é, do ponto de vista de quem vai lê-lo.
enum MediaKind {
  IMAGE
  AUDIO
  DOCUMENT
  /// Reconhecido, mas sem leitura possível aqui (vídeo, localização, contato).
  /// Ainda vira texto para o agente — "o cliente mandou um vídeo" é contexto.
  UNSUPPORTED
}

enum MediaStatus {
  OK
  /// Falhou e vale tentar de novo: rede, 429, 5xx, timeout.
  ERROR
  /// Falhou de vez: formato sem leitor, arquivo grande demais, tentativas
  /// esgotadas. Não tenta mais — e o agente recebe o texto explicando.
  SKIPPED
}

/// Leitura de um anexo, guardada para não pagar duas vezes pelo mesmo arquivo.
///
/// O worker relê o histórico INTEIRO do Chatwoot a cada turno. Sem este cache,
/// um áudio de dez minutos seria transcrito de novo a cada mensagem seguinte da
/// mesma conversa, e a conta da OpenAI cresceria com o tamanho da conversa em
/// vez de com a quantidade de mídia.
///
/// A chave identifica o ARQUIVO, não a mensagem: o mesmo anexo reencaminhado
/// numa segunda conversa reaproveita a leitura.
///
/// Sem chave estrangeira para `Agent`/`Conversation` de propósito: excluir um
/// agente cascatearia e apagaria o cache de arquivos que continuam existindo.
/// `agentId` e `conversationId` aqui são procedência, não vínculo — mesmo
/// padrão de `WebhookEvent.agentId`.
model MediaAnalysis {
  id String @id @default(cuid())

  /// `chatwoot:<id do anexo>` quando o Chatwoot dá um id; senão o hash da URL.
  chave String @unique

  kind   MediaKind
  status MediaStatus

  nomeArquivo  String?
  mimeType     String?
  tamanhoBytes Int?

  /// O texto que entra no lugar do anexo na mensagem enviada ao modelo.
  /// Preenchido também em `SKIPPED` — dizer "não consegui ler este áudio" é
  /// melhor do que o agente responder como se nada tivesse chegado.
  texto String? @db.Text
  erro  String?

  /// Quantas vezes já falhou. Passou do teto, vira `SKIPPED` e para de tentar —
  /// senão um arquivo quebrado seria reprocessado a cada turno para sempre.
  tentativas Int @default(0)

  /// Modelo da OpenAI usado nesta leitura, congelado como em `AgentRun.model`.
  model        String?
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  /// Segundos de áudio, quando a API informa. É por aqui que se estima o custo
  /// de transcrição, que é cobrado por duração e não por token.
  segundosDeAudio Int?
  duracaoMs       Int?

  /// Procedência, para a tela responder "de onde veio esta leitura?".
  agentId           String?
  conversationId    String?
  chatwootMessageId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([agentId, createdAt(sort: Desc)])
}

/// Estado de um rodízio de atendentes — quem recebeu por último.
///
/// Mora aqui, e não no Chatwoot, porque é regra nossa: o Chatwoot só sabe
/// distribuir por time, e nem todo rodízio é um time (a dupla que reveza
/// reservas pode ser duas pessoas de times diferentes).
///
/// A chave é o nome que o prompt usa. Trocar os participantes não zera o
/// estado: quem sai da lista simplesmente deixa de ser considerado.
model Rodizio {
  nome      String   @id
  /// Nome do último atendente sorteado. Nulo = ainda não rodou.
  ultimo    String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// De quem se espera a resposta.
enum PrazoTipo {
  /// Uma pessoa da equipe acabou de receber a conversa.
  EQUIPE
  /// O bot fez uma pergunta ao cliente.
  CLIENTE
}

enum PrazoStatus {
  PENDENTE
  /// Pego por uma volta do vigia. Trava contra duas execuções do mesmo prazo.
  EXECUTANDO
  EXECUTADO
  /// A conferência ao vivo mostrou que não cabe agir (alguém respondeu,
  /// outra pessoa assumiu, conversa resolvida) — ou um prazo novo substituiu.
  CANCELADO
  /// Não agiu por razão do sistema: tarde demais, integração desligada, sem
  /// credencial.
  DESCARTADO
  FALHOU
}

/// Prazo de uma conversa: "se ninguém responder em N minutos, faça X".
///
/// Registrado pelo agente (integração PRAZOS) e executado pelo vigia, que
/// confere a conversa AO VIVO no Chatwoot antes de agir. Ver
/// `src/server/prazos/`. Um só PENDENTE por conversa e tipo: índice parcial
/// `PrazoDeConversa_um_pendente`, na migration.
model PrazoDeConversa {
  id                     String      @id @default(cuid())
  chatwootConversationId Int
  /// Agente que registrou. Outro agente assumir a conversa derruba o prazo.
  agentId                String
  /// Dono do bot pelo qual a conversa entrou: a credencial que o vigia usa.
  portaAgentId           String
  tipo                   PrazoTipo
  status                 PrazoStatus @default(PENDENTE)
  minutos                Int
  venceEm                DateTime
  /// Maior id de mensagem da conversa quando o prazo nasceu. "Respondeu" é
  /// existir mensagem com id maior — id, e não relógio, porque a resposta do
  /// próprio bot no mesmo turno chega depois da chamada da ferramenta.
  referenciaMensagemId   Int
  /// EQUIPE: quem era o dono quando o prazo nasceu.
  donoId                 Int?
  donoNome               String?
  /// O que fazer no vencimento: `AcaoDoPrazo` em `prazos/decisao.ts`.
  acao                   Json
  /// Por que o agente registrou. Vai na nota interna.
  motivo                 String      @db.Text
  resultado              String?     @db.Text
  criadoEm               DateTime    @default(now())
  finalizadoEm           DateTime?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status, venceEm])
  @@index([chatwootConversationId, tipo, status])
}

/// Onde a pesquisa de satisfação está. As transições em `src/server/nps/executar.ts`.
enum PesquisaNpsStatus {
  /// O checkbox foi marcado; a pesquisa ainda não saiu.
  AGENDADA
  /// Enviada, esperando a nota. `venceEm` é a hora do lembrete.
  AGUARDANDO
  /// Lembrete enviado, esperando a nota. `venceEm` é a hora de resolver.
  LEMBRADA
  /// A nota chegou; falta responder e gravar no CRM.
  RESPONDIDA
  /// Respondida e gravada. Recebe complementos; `venceEm` é a hora de resolver.
  AGRADECIDA
  /// Nota recebida e fim do prazo depois dela.
  CONCLUIDA
  /// Sem nota até o fim do prazo depois do lembrete.
  EXPIRADA
  /// Não cabia agir: alguém assumiu, o cliente falou de outra coisa, a
  /// pesquisa foi desligada, o telefone já tinha recebido.
  CANCELADA
  FALHOU
}

/// Uma pesquisa de satisfação, do checkbox marcado ao fim. O estado mora aqui
/// e o vigia executa, como nos prazos: a fila só adianta o relógio.
model PesquisaNps {
  id                     String            @id @default(cuid())
  chatwootConversationId Int
  inboxId                Int?
  /// O robô da caixa, dono da credencial que manda as mensagens.
  portaAgentId           String?
  /// DDD + número (`telefoneCanonico`): "o mesmo telefone em 24 h".
  telefone               String?
  status                 PesquisaNpsStatus @default(AGENDADA)
  /// Instante da marcação do checkbox. Com a conversa, é a idempotência.
  marcadaEm              DateTime
  /// Quando a etapa atual deve rodar.
  venceEm                DateTime
  enviadaEm              DateTime?
  /// Maior id de mensagem ao enviar: "depois da pesquisa" é id maior que este.
  referenciaMensagemId   Int?
  lembreteEm             DateTime?
  nota                   Int?
  notaMensagemId         Int?
  respondidaEm           DateTime?
  /// Última mensagem do cliente depois da nota. O encerramento conta daqui.
  ultimaMensagemEm       DateTime?
  /// Onde a nota foi gravada: `RegistroDaNota` em `nps/crm.ts`.
  registro               Json?
  /// Rastro para a tela: o que foi feito e o que não foi, em ordem.
  resultado              String?           @db.Text
  /// Falhas seguidas da etapa atual.
  tentativas             Int               @default(0)
  criadaEm               DateTime          @default(now())
  finalizadaEm           DateTime?

  @@unique([chatwootConversationId, marcadaEm])
  @@index([status, venceEm])
  @@index([chatwootConversationId, status])
  @@index([telefone, enviadaEm])
}

enum TipoDeAvisoDeSaldo {
  /// Saldo abaixo do limite configurado.
  BAIXO
  /// Saldo zerado (ou negativo): os agentes já não respondem.
  ZERADO
  /// Mandado pelo botão da tela, para provar que a mensagem chega.
  TESTE
}

/// Alerta de saldo da OpenRouter por WhatsApp (18/09/2026). Linha ÚNICA
/// (`id = "unico"`), configurada em /consumo.
///
/// Tabela própria, e não uma linha de `Integration` como o NPS: não é
/// integração, não tem tool nem liga por agente, e como provider apareceria nas
/// listas de Integrações e do MCP. Configuração e estado moram juntos, em
/// colunas separadas: quem salva o formulário não toca no estado, e o vigia não
/// toca na configuração.
model AlertaDeSaldo {
  id            String   @id @default("unico")
  ligado        Boolean  @default(false)
  limiteUsd     Float    @default(20)
  /// Caixa do Chatwoot por onde o alerta sai. A 31 é API não oficial (WAHA):
  /// sem janela de 24 h, dá para iniciar conversa a qualquer momento.
  caixaId       Int      @default(31)
  /// `[{ nome, telefone }]`, telefone em E.164. Só Administrador vê.
  destinatarios Json     @default("[]")

  /// Início do episódio: desde quando o saldo está abaixo do limite. Nulo
  /// quando está acima — voltar acima é o que zera o episódio.
  abaixoDesde DateTime?
  /// Último aviso do episódio: é por ele que o próximo espera 24 h.
  avisadoEm   DateTime?
  avisadoTipo TipoDeAvisoDeSaldo?
  conferidoEm DateTime?
  /// Por que a última conferência não chegou ao fim. Nulo quando chegou.
  ultimaFalha String?  @db.Text

  atualizadoPorId String?
  updatedAt       DateTime @updatedAt
}

/// Um envio do alerta: o rastro que a tela mostra. Sem telefone — o que foi
/// para quem sai pelo nome.
model AvisoDeSaldo {
  id        String             @id @default(cuid())
  tipo      TipoDeAvisoDeSaldo
  saldoUsd  Float?
  limiteUsd Float
  /// `[{ nome, ok, detalhe, conversaId }]`, na ordem dos destinatários.
  entregas  Json
  entregues Int
  falhas    Int
  /// Quem apertou o botão de teste. Nulo nos avisos do relógio.
  autorId   String?
  criadoEm  DateTime           @default(now())

  @@index([criadoEm])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  action   String // ex.: "agent.prompt.updated", "integration.credential.rotated"
  entity   String
  entityId String
  diff     Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
