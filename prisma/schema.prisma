// Seahub Agentes — schema principal.
// Single-tenant: atende apenas a Seahub, não há tenantId por decisão de 2026-07-28.
// A URL do banco fica em prisma.config.ts (Prisma 7), lida de DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Acesso ao painel
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER // gerencia credenciais de integração
  ADMIN // gerencia agentes
  VIEWER // só leitura
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentVersions AgentVersion[]
  auditLogs     AuditLog[]
  agentesQuePossui  Agent[] @relation("DonoDoAgente")
  agentesQueAlterou Agent[] @relation("UltimaAlteracaoDoAgente")
}

// ---------------------------------------------------------------------------
// Agentes
// ---------------------------------------------------------------------------

model Agent {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  /// Identificador curto e estável usado pelos colegas para transferir
  /// ("vendas", "suporte"). O modelo não consegue usar cuid de forma confiável —
  /// e mudar o nome do agente não pode quebrar as transferências.
  key String @unique

  /// "Quando me transferir uma conversa." Entra no prompt de TODOS os outros
  /// agentes como roster; é por aqui que um colega sabe que este existe.
  /// Separado do systemPrompt de propósito: o prompt fala com o próprio agente,
  /// este texto fala com os outros.
  routingDescription String? @db.Text

  /// O agente de entrada recebe a primeira mensagem e distribui. Só um pode
  /// estar ligado — sem isso, quem responde primeiro seria arbitrário.
  isEntry Boolean @default(false)

  /// Em quais caixas de entrada do Chatwoot este agente atua.
  /// `all` = qualquer uma; `specific` = só as listadas em `inboxIds`.
  inboxMode String @default("all") // all | specific
  /// Ids das caixas no Chatwoot. Só vale com `inboxMode = specific`.
  inboxIds  Int[]  @default([])

  systemPrompt String @db.Text

  // Modelo e custo. Ver docs/00-stack-e-arquitetura.md §7.
  // `model` é o slug da OpenRouter (ex.: "openai/gpt-5.6-luna").
  model             String @default("openai/gpt-5.6-luna")
  effort            String @default("medium") // none | low | medium | high
  /// Teto de saída por chamada. Alto de propósito: um turno pode encadear
  /// transferências e vários usos de tool antes da resposta final, e o runner
  /// ainda corta pelo limite real do modelo (ModeloCatalogo.maxSaida).
  maxTokens         Int    @default(16384)
  /// Rodadas de tool por turno. Descobrir estrutura, consultar e então agir já
  /// gasta várias — 12 dá folga sem virar laço infinito.
  maxToolIterations Int    @default(12)

  active Boolean @default(false) // nasce desligado: só entra em produção de propósito

  /// Guardado sem apagar: some da lista principal e não atende, mas mantém
  /// prompt, modelo, integrações e histórico intactos.
  ///
  /// Estado separado de `active` de propósito. Desligado é pausa; arquivado é
  /// "tirei de circulação". Restaurar devolve o agente **desligado** — voltar a
  /// atender é uma segunda decisão, consciente.
  archivedAt DateTime?

  /// Quantos minutos o cliente pode ficar esperando antes de a conversa ser
  /// entregue a uma pessoa. Nulo = usa o padrão do sistema.
  ///
  /// Existe porque nem toda falha grita: modelo pendurado, worker morto no meio
  /// do turno ou job perdido deixam o cliente no vácuo sem erro nenhum.
  fallbackMinutos Int?
  /// Para quem escalar quando o tempo estoura. Nulo = devolve à fila humana
  /// sem escolher pessoa.
  fallbackAtendente String?

  /// Espera antes de responder, para agrupar mensagens picotadas do cliente
  /// ("oi" / "tudo bem?" / "queria saber sobre sala") numa resposta só.
  /// Canal mais conversacional pede mais; e-mail pede menos.
  debounceSeconds Int @default(6)

  // Repasse para humano
  handoffEnabled  Boolean @default(true)
  handoffTeamId   Int? // id do time no Chatwoot
  handoffOnErrors Int     @default(2) // nº de falhas de tool antes de transferir

  /// Quem responde pelo agente. Não é controle de acesso — é saber a quem
  /// perguntar quando o atendimento sair errado.
  ownerId String?
  /// Quem mexeu por último, para a tela mostrar sem ter de abrir a auditoria.
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User? @relation("DonoDoAgente", fields: [ownerId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("UltimaAlteracaoDoAgente", fields: [updatedById], references: [id], onDelete: SetNull)

  versions      AgentVersion[]
  integrations  AgentIntegration[]
  conversations Conversation[]
  runs          AgentRun[]
  chatwootBot   AgentChatwootBot?
  trigger       AgentTrigger?
  schedules     AgentSchedule[]

  handoffsFeitos    AgentHandoff[] @relation("HandoffDe")
  handoffsRecebidos AgentHandoff[] @relation("HandoffPara")
  conversasEmTransicao Conversation[] @relation("HandoffDestino")

  @@index([isEntry])
  @@index([archivedAt])
}

/// Registro de cada passagem de bastão entre agentes.
///
/// Auditoria, não estado: o estado de quem atende agora fica em
/// `Conversation.agentId`. Serve para responder "por que este agente respondeu?"
/// e para achar par de agentes que vive se transferindo.
model AgentHandoff {
  id             String  @id @default(cuid())
  conversationId String
  /// Nulo quando quem passou foi um humano ou o próprio sistema.
  fromAgentId    String?
  toAgentId      String

  motivo String? @db.Text
  resumo String? @db.Text
  /// O que o cliente viu no momento da passagem.
  aviso  String? @db.Text

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromAgent    Agent?       @relation("HandoffDe", fields: [fromAgentId], references: [id], onDelete: SetNull)
  toAgent      Agent        @relation("HandoffPara", fields: [toAgentId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Um Agent Bot do Chatwoot por agente — decisão de 2026-07-28, para cada agente
/// ter nome e avatar próprios na interface do Chatwoot.
///
/// Consequência: cada bot tem o **seu** secret de webhook. Por isso o endpoint é
/// `/api/webhooks/chatwoot/<agentId>` — a URL identifica o bot antes da
/// verificação da assinatura, evitando ter de confiar no payload para escolher a
/// chave.
model AgentChatwootBot {
  id      String @id @default(cuid())
  agentId String @unique

  /// Id numérico do bot no Chatwoot. Serve para vincular inboxes e para ignorar
  /// as mensagens que o próprio bot enviou.
  botId   Int?
  botName String

  /// Conta do Chatwoot deste bot. Nulo = usa a conta da configuração global.
  /// Permite ter agentes em contas diferentes da mesma instância.
  accountId Int?

  /// JSON cifrado (AES-256-GCM): { token, webhookSecret }.
  /// Um blob só em vez de duas colunas cifradas — menos ruído no schema.
  ciphertext String @db.Text
  iv         String
  authTag    String
  /// Máscara do token, para conferência visual no painel.
  hint       String

  rotatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

/// Gatilho HTTP genérico por agente — aciona fora de uma conversa do Chatwoot,
/// por POST de qualquer sistema externo (ClickUp, n8n, curl). A URL inteira é
/// `/api/webhooks/gatilho/<agentId>/<token>`.
///
/// Diferente de toda outra credencial do projeto: aqui o segredo nasce do
/// NOSSO lado — é a única forma de o operador colá-lo na URL configurada no
/// sistema externo. Por isso é devolvido em texto puro uma única vez, na
/// criação/rotação; depois, só `hint`. Cifrado em repouso como tudo mais.
model AgentTrigger {
  id      String @id @default(cuid())
  agentId String @unique

  /// Nasce DESLIGADO — mesma doutrina de Agent.active/Integration.enabled
  /// ("só entra em produção de propósito"). Gerar o token não liga sozinho; o
  /// operador ainda precisa configurar o prompt e ligar conscientemente.
  enabled Boolean @default(false)

  ciphertext String @db.Text
  iv         String
  authTag    String
  hint       String

  rotatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Preenchido quando o teto de execuções estourou e o sistema desligou o
  /// gatilho sozinho. Fica visível no painel — silêncio precisa deixar
  /// rastro — e só some quando alguém religar conscientemente.
  pausadoAutomaticamenteEm     DateTime?
  pausadoAutomaticamenteMotivo String?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

/// Um agendamento: o agente roda sozinho na hora marcada, sem gatilho externo.
///
/// Vários por agente de propósito — diferente de `AgentTrigger`, que é um só.
/// "Resumo às 8h" e "cobranças às 18h" são dois agendamentos do mesmo agente,
/// com instruções diferentes, e cada um liga e desliga por conta própria.
///
/// ⚠ **O Postgres é a fonte da verdade; o Redis só executa.** O relógio de
/// verdade é o Job Scheduler do BullMQ, que vive no Redis — mas Redis limpo
/// faria os agendamentos sumirem em silêncio. Por isso o worker reconcilia
/// estas linhas contra o Redis toda vez que sobe.
model AgentSchedule {
  id      String @id @default(cuid())
  agentId String

  /// Como aparece na tela e no rastro de execução. "Resumo diário".
  nome String

  /// Expressão de 5 campos, **sempre** interpretada em `America/Sao_Paulo`.
  /// O container roda em UTC: sem fuso explícito, "9h" viraria 6h da manhã.
  cron String

  /// O que o agente deve fazer nesta execução. Vira a `mensagem` do turno —
  /// aqui não há payload de sistema externo nem cliente perguntando nada.
  instrucao String @db.Text

  /// Nasce desligado, como `Agent.active` e `AgentTrigger.enabled`.
  enabled Boolean @default(false)

  /// Quanto tempo depois da hora marcada ainda vale executar.
  ///
  /// O worker fora do ar na hora marcada (deploy, queda) faz o BullMQ entregar
  /// a ocorrência atrasada quando volta. Rodar o "resumo das 8h" às 15h como se
  /// nada fosse é pior que não rodar: o agente age sobre um contexto que já
  /// passou. Passou da tolerância, pula e registra o motivo.
  toleranciaMinutos Int @default(60)

  ultimaExecucaoEm DateTime?
  /// `executado` · `falhou` · `pulado` · `interrompido`.
  ultimoResultado  String?
  ultimoDetalhe    String?

  /// Zera a cada sucesso. Estourou o teto, o agendamento se desliga sozinho —
  /// agendamento quebrado não pode queimar crédito para sempre.
  falhasConsecutivas Int @default(0)

  pausadoAutomaticamenteEm     DateTime?
  pausadoAutomaticamenteMotivo String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([enabled])
}

/// Histórico imutável de prompt. Permite rollback quando um ajuste piora o atendimento.
model AgentVersion {
  id      String @id @default(cuid())
  agentId String
  version Int

  systemPrompt String  @db.Text
  model        String
  effort       String
  note         String?

  createdById String?
  createdAt   DateTime @default(now())

  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([agentId, version])
  @@index([agentId])
  @@index([agentId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Integrações
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  CHATWOOT
  CLICKUP
  CONEXA
  ZAPSIGN
  /// Leitura de mídia (áudio, imagem, documento). Não expõe tool nenhuma: é um
  /// passo de preparo do contexto, antes de o agente pensar. Está aqui, e não
  /// numa tabela própria, para reusar credencial cifrada, toggle global e
  /// toggle por agente — capacidade duplicada é a que diverge.
  OPENAI
  /// Conferência de documento (CPF, CNH, CNPJ). Sem credencial: usa algoritmo
  /// público e a consulta gratuita de CNPJ da base aberta da Receita. Está no
  /// registry pelo toggle de dois níveis e pela allowlist, não pela conta.
  DOCUMENTOS
}

enum IntegrationStatus {
  NOT_CONFIGURED
  OK
  ERROR
}

/// Uma conexão configurada. `enabled` é o toggle GLOBAL: desligou aqui,
/// nenhum agente enxerga as tools desta integração.
model Integration {
  id       String              @id @default(cuid())
  provider IntegrationProvider @unique
  label    String

  /// Config não-sensível (baseUrl, accountId, workspaceId...). Validada por Zod no registry.
  config Json @default("{}")

  enabled Boolean @default(false)

  status        IntegrationStatus @default(NOT_CONFIGURED)
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credential IntegrationCredential?
  agents     AgentIntegration[]
}

/// Segredos cifrados (AES-256-GCM), separados da config visível.
/// A API nunca devolve `ciphertext` — só `hint`.
model IntegrationCredential {
  id            String @id @default(cuid())
  integrationId String @unique

  ciphertext String @db.Text
  iv         String
  authTag    String
  hint       String // ex.: "••••4f2a", para conferência visual no painel

  rotatedAt DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

/// Toggle POR AGENTE + allowlist de tools. O array de tools enviado ao modelo é a
/// interseção deste nível com Integration.enabled.
model AgentIntegration {
  id            String @id @default(cuid())
  agentId       String
  integrationId String

  enabled Boolean @default(false)

  /// Vazio = todas as tools da integração. Preenchido = só estas.
  allowedTools String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([agentId, integrationId])
  @@index([agentId])
  @@index([agentId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Conversas e execuções
// ---------------------------------------------------------------------------

enum ConversationStatus {
  BOT // agente respondendo
  HUMAN // transferida, bot calado
  CLOSED
}

model Conversation {
  id                     String @id @default(cuid())
  chatwootConversationId Int    @unique
  chatwootInboxId        Int

  agentId String?
  status  ConversationStatus @default(BOT)

  contactName       String?
  contactIdentifier String?

  handoffReason String?
  handoffAt     DateTime?

  /// Bastão da última passagem entre agentes. Lido pelo agente que assumiu e
  /// injetado como mensagem `system` antes da fala do cliente — nunca no
  /// systemPrompt, que precisa ficar estável para o cache do provedor.
  ///
  /// Zerado junto com `historicoDesde` quando a conversa é resolvida: reabriu,
  /// volta para o agente de entrada sem herdar o especialista anterior.
  handoffParaAgentId String?
  handoffResumo      String? @db.Text
  handoffMotivo      String? @db.Text
  handoffDeNome      String?

  /// Marco de corte do histórico. Mensagens anteriores a esta data não vão para
  /// o modelo.
  ///
  /// É gravado toda vez que a conversa é vista como resolvida: se ela reabrir, o
  /// atendimento começa do zero, porque o mesmo cliente costuma voltar por outro
  /// assunto e o contexto antigo atrapalharia mais do que ajudaria.
  historicoDesde DateTime?
  resolvidaEm    DateTime?

  /// Desde quando o cliente espera resposta. Gravado quando a mensagem dele
  /// entra na fila e zerado quando o agente responde — é o relógio do vigia.
  ///
  /// Separado de , que é atualizado pelos dois lados e por isso
  /// não distingue "cliente esperando" de "conversa ativa".
  aguardandoDesde DateTime?

  /// Agente dono do bot pelo qual a conversa entrou. Quem precisa falar com o
  /// Chatwoot fora de um turno (o vigia) não teria outro jeito de achar a
  /// credencial certa.
  portaAgentId String?

  /// Por que o último processamento não chegou a responder.
  ///
  /// Falha antes da chamada ao modelo não cria `AgentRun` — sem isto, o painel
  /// mostrava "ainda sem resposta" para sempre e a causa só existia no log do
  /// container.
  ultimaFalha   String?
  ultimaFalhaEm DateTime?

  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agent          Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  handoffPara    Agent?         @relation("HandoffDestino", fields: [handoffParaAgentId], references: [id], onDelete: SetNull)
  runs           AgentRun[]
  handoffs       AgentHandoff[]

  @@index([agentId])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([status])
}

enum RunSource {
  PLAYGROUND
  CHATWOOT
  TRIGGER
  /// Disparado pelo relógio, sem ninguém do outro lado.
  SCHEDULE
}

enum RunStatus {
  RUNNING
  SUCCESS
  ERROR
  /// Interrompida de propósito por alguém no painel.
  ///
  /// Separado de `ERROR` porque não é falha: a apuração de consumo conta erros
  /// para dizer "quanto se gastou sem resultado", e uma parada deliberada
  /// entrando nessa conta faria o operador caçar um defeito que ele mesmo
  /// causou. O custo até o ponto da parada continua sendo cobrado e contado.
  CANCELED
}

/// Uma execução completa do agente (do input até a resposta final).
/// É isto que permite responder "por que o bot respondeu isso?".
model AgentRun {
  id             String  @id @default(cuid())
  agentId        String
  conversationId String?

  source RunSource
  status RunStatus @default(RUNNING)

  /// Slug da OpenRouter usado NESTA execução, congelado no momento em que ela
  /// rodou. Sem isto a apuração de consumo por modelo teria de ler
  /// `Agent.model`, que é o modelo de **agora** — trocar de modelo reescreveria
  /// o passado inteiro da fatura.
  ///
  /// A migration preencheu o histórico a partir de `AgentVersion` (a versão
  /// vigente na data da execução). Fica **nulo** só onde não havia evidência
  /// nenhuma: agente sem histórico de versão, anterior ao versionamento. Aí a
  /// tela de Consumo mostra "modelo não registrado" em vez de chutar o modelo
  /// atual do agente — o custo total continua certo, e a quebra por modelo diz
  /// a verdade sobre o que não dá para saber.
  model String?

  input  String  @db.Text
  output String? @db.Text

  /// Histórico completo enviado/recebido, para replay e depuração.
  messages Json @default("[]")

  inputTokens         Int @default(0)
  outputTokens        Int @default(0)
  cacheReadTokens     Int @default(0)
  cacheCreationTokens Int @default(0)

  costUsd    Decimal? @db.Decimal(12, 6)
  latencyMs  Int?
  iterations Int      @default(0)

  error String? @db.Text

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  toolCalls    ToolCall[]

  @@index([agentId, createdAt])
  @@index([conversationId])
  /// A apuração de consumo varre por PERÍODO, sem agente: o índice composto
  /// acima não serve, porque `agentId` é a primeira coluna dele.
  @@index([createdAt])
}

model ToolCall {
  id    String @id @default(cuid())
  runId String

  toolName   String
  provider   IntegrationProvider?
  input      Json
  output     Json?
  isError    Boolean              @default(false)
  durationMs Int?

  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ---------------------------------------------------------------------------
// Operação
// ---------------------------------------------------------------------------

/// Deduplicação de webhook: o Chatwoot reenvia em caso de falha.
model WebhookEvent {
  id       String @id @default(cuid())
  provider String
  /// X-Chatwoot-Delivery. É a chave de idempotência: o Chatwoot reenvia em falha.
  externalId String
  eventType  String
  /// Qual agente recebeu — vem da URL do webhook, uma por bot.
  agentId    String?
  payload    Json

  /// O que o sistema fez com a entrega: `agendado`, `ignorado` ou `rejeitado`.
  ///
  /// Existe para a tela do agente responder "chegou alguma coisa?" sem obrigar
  /// ninguém a ler log de container. Sem isto, entrega recusada por assinatura
  /// não deixava rastro nenhum — voltava 401 antes de qualquer escrita — e o
  /// operador só via silêncio.
  resultado String?
  /// Por que foi ignorada ou recusada, em texto para humano.
  detalhe   String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([processedAt])
  @@index([agentId])
  @@index([agentId, createdAt(sort: Desc)])
}

/// O que o anexo é, do ponto de vista de quem vai lê-lo.
enum MediaKind {
  IMAGE
  AUDIO
  DOCUMENT
  /// Reconhecido, mas sem leitura possível aqui (vídeo, localização, contato).
  /// Ainda vira texto para o agente — "o cliente mandou um vídeo" é contexto.
  UNSUPPORTED
}

enum MediaStatus {
  OK
  /// Falhou e vale tentar de novo: rede, 429, 5xx, timeout.
  ERROR
  /// Falhou de vez: formato sem leitor, arquivo grande demais, tentativas
  /// esgotadas. Não tenta mais — e o agente recebe o texto explicando.
  SKIPPED
}

/// Leitura de um anexo, guardada para não pagar duas vezes pelo mesmo arquivo.
///
/// O worker relê o histórico INTEIRO do Chatwoot a cada turno. Sem este cache,
/// um áudio de dez minutos seria transcrito de novo a cada mensagem seguinte da
/// mesma conversa, e a conta da OpenAI cresceria com o tamanho da conversa em
/// vez de com a quantidade de mídia.
///
/// A chave identifica o ARQUIVO, não a mensagem: o mesmo anexo reencaminhado
/// numa segunda conversa reaproveita a leitura.
///
/// Sem chave estrangeira para `Agent`/`Conversation` de propósito: excluir um
/// agente cascatearia e apagaria o cache de arquivos que continuam existindo.
/// `agentId` e `conversationId` aqui são procedência, não vínculo — mesmo
/// padrão de `WebhookEvent.agentId`.
model MediaAnalysis {
  id String @id @default(cuid())

  /// `chatwoot:<id do anexo>` quando o Chatwoot dá um id; senão o hash da URL.
  chave String @unique

  kind   MediaKind
  status MediaStatus

  nomeArquivo  String?
  mimeType     String?
  tamanhoBytes Int?

  /// O texto que entra no lugar do anexo na mensagem enviada ao modelo.
  /// Preenchido também em `SKIPPED` — dizer "não consegui ler este áudio" é
  /// melhor do que o agente responder como se nada tivesse chegado.
  texto String? @db.Text
  erro  String?

  /// Quantas vezes já falhou. Passou do teto, vira `SKIPPED` e para de tentar —
  /// senão um arquivo quebrado seria reprocessado a cada turno para sempre.
  tentativas Int @default(0)

  /// Modelo da OpenAI usado nesta leitura, congelado como em `AgentRun.model`.
  model        String?
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  /// Segundos de áudio, quando a API informa. É por aqui que se estima o custo
  /// de transcrição, que é cobrado por duração e não por token.
  segundosDeAudio Int?
  duracaoMs       Int?

  /// Procedência, para a tela responder "de onde veio esta leitura?".
  agentId           String?
  conversationId    String?
  chatwootMessageId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([agentId, createdAt(sort: Desc)])
}

/// Estado de um rodízio de atendentes — quem recebeu por último.
///
/// Mora aqui, e não no Chatwoot, porque é regra nossa: o Chatwoot só sabe
/// distribuir por time, e nem todo rodízio é um time (a dupla que reveza
/// reservas pode ser duas pessoas de times diferentes).
///
/// A chave é o nome que o prompt usa. Trocar os participantes não zera o
/// estado: quem sai da lista simplesmente deixa de ser considerado.
model Rodizio {
  nome      String   @id
  /// Nome do último atendente sorteado. Nulo = ainda não rodou.
  ultimo    String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  action   String // ex.: "agent.prompt.updated", "integration.credential.rotated"
  entity   String
  entityId String
  diff     Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
